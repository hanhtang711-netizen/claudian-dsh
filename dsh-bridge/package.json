{
  "name": "dsh-claudian-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness ACP bridge: exposes the DSH agent core as an Agent Client Protocol server over stdio so Claudian can drive it as a chat provider.",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/minimal.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./startup": {
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-cmdline": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-plan-mode": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.2",
    "commander": "^15.0.0"
  }
}
