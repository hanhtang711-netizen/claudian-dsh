{
  "name": "dsh-claudian-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness ACP bridge: exposes the DSH agent core as an Agent Client Protocol server over stdio so Claudian can drive it as a chat provider.",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./startup": {
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-plan-mode": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "commander": "^15.0.0"
  }
}
